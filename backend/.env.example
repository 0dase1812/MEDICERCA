APP_NAME=MediCerca API
ENVIRONMENT=local

# Base central: usuarios, EPS, catálogo nacional de medicamentos
DATABASE_URL=postgresql+psycopg2://medicerca:medicerca@db_central:5432/medicerca

# Una base de datos por cada IPS simulada (independientes entre sí)
DATABASE_URL_IPS_1=postgresql+psycopg2://medicerca:medicerca@db_ips1:5432/ips1
DATABASE_URL_IPS_2=postgresql+psycopg2://medicerca:medicerca@db_ips2:5432/ips2
DATABASE_URL_IPS_3=postgresql+psycopg2://medicerca:medicerca@db_ips3:5432/ips3

SECRET_KEY=cambia-esta-llave-por-una-generada-con-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Clave compartida para POST /api/v1/admin/regentes (header X-Admin-Key).
# Genere una distinta a SECRET_KEY, ej. con: openssl rand -hex 32
ADMIN_KEY=cambia-esta-llave-por-otra-generada-con-openssl-rand-hex-32

# Dominios del frontend que pueden llamar a esta API, separados por coma.
# En producción, restrinja esto a los dominios reales — nunca use "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# "simulado": el código OTP viene en la respuesta de la API en vez de
# enviarse a un correo real (no requiere cuenta de correo configurada).
# "real": se envía con Brevo (requiere BREVO_API_KEY).
EMAIL_MODO=simulado

# Cuenta gratuita en https://www.brevo.com (300 correos/día gratis).
BREVO_API_KEY=
EMAIL_REMITENTE=no-responder@medicerca.demo
EMAIL_REMITENTE_NOMBRE=MediCerca

# Clave secreta de reCAPTCHA v2 (https://www.google.com/recaptcha/admin).
# Si se deja vacía, no se exige captcha (útil en desarrollo/pruebas).
RECAPTCHA_SECRET_KEY=

# true solo para desarrollo/demo local. En despliegue use Alembic y configure false.
AUTO_CREATE_SCHEMA=true
